{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements", "conflicts", "constraints", "budget_inr", "register_findings", "plan", "open_questions"],
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "source_persona", "status"],
        "properties": {
          "id": { "type": "string" },
          "text": { "type": "string" },
          "source_persona": { "type": "string" },
          "status": { "type": "string", "enum": ["confirmed", "conflicting", "assumed"] }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["between", "about", "resolution"],
        "properties": {
          "between": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
          "about": { "type": "string" },
          "resolution": { "type": "string" }
        }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "budget_inr": { "type": ["number", "null"] },
    "register_findings": { "type": "array", "items": { "type": "string" } },
    "plan": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  }
}
